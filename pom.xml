<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nalxer</groupId>
    <artifactId>NalxerApp</artifactId>
    <version>26.13.11</version>
    <packaging>jar</packaging>

    <name>NalxerApp</name>
    <description>Nalxer 服务器手机 App 数据接口（AuthMe 登录 / 金币 / 点券 / 等级 / 封禁管理）</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 硬依赖：直接编译期调用 InTheNameOfLinux 的 API（举报 / 惩罚 / 封禁 / 身份） -->
        <dependency>
            <groupId>com.inthenameoflinux</groupId>
            <artifactId>InTheNameOfLinux</artifactId>
            <version>26.11.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/InTheNameOfLinux.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- 服务端本体：编译期用，运行期由服务器提供（反射调用 NMS / AuthMe 等） -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot</artifactId>
            <version>1.12.2</version>
            <scope>system</scope>
            <systemPath>${basedir}/spigot-1.12.2.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>LinuxAPP</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
