<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http 明文（接口本身强制应用层 AES-GCM 加密），同时允许用户安装的 CA -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
